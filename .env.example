# Massive (formerly Polygon.io) API key — https://massive.com/dashboard/keys
# Server-side only: it is never sent to the browser.
MASSIVE_API_KEY=

# Calls per minute your plan allows. Free "Basic" = 5. Paid plans are unlimited → set 0.
MASSIVE_RATE_LIMIT_PER_MIN=5

# Years of daily history your stocks plan includes: Basic 2, Starter 5, Developer 10, Advanced 20.
MASSIVE_HISTORY_YEARS=2

# Live option chains (greeks/IV/OI/quotes) need a Massive Options plan.
# auto = try when not rate limited, on = always try, off = always use the model chain.
MASSIVE_OPTIONS_LIVE=auto

# Trading days of market-wide history for the scanner (RVOL, 5D/20D change need ~21).
# Defaults to 2 on rate-limited plans and 21 otherwise.
# SCANNER_LOOKBACK_DAYS=21

# Where API responses are cached on disk (defaults to ./.cache/massive).
# QS_CACHE_DIR=/tmp/quantscope-cache
